# Copy to .env.local for local development. In Vercel these go under Project Settings > Environment Variables. Never commit real values.

# --- Site
NEXT_PUBLIC_SITE_URL=https://www.ttrdentalmarketers.com

# --- Sanity (the project is created by a person, TTR-1567; its ID is public)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Viewer token "TTR OS read": draft previews for TTR OS. Production and Preview, Sensitive.
SANITY_READ_TOKEN=
# Signs the /api/preview links TTR OS makes. SANITY_PREVIEW_SECRET is read if this is empty.
PREVIEW_SECRET=
# Same value in the Sanity publish webhook: POST https://www.ttrdentalmarketers.com/api/revalidate
SANITY_REVALIDATE_SECRET=
# Only for `npm run seed` on a computer (Editor token). Not needed in Vercel.
SANITY_WRITE_TOKEN=
